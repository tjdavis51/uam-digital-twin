# Supported host platform
UAM_UBUNTU_VERSION=24.04
UAM_ROS_DISTRO=jazzy
UAM_GAZEBO_RELEASE=harmonic
UAM_GAZEBO_SIM_MAJOR=8

# Reference checkpoint (human-readable labels plus immutable commits)
UAM_PX4_LABEL=v1.17.0
UAM_PX4_COMMIT=d6f12ad1c4f70ad3230afd7d86e971421e02fef4
UAM_PX4_MSGS_LABEL=v1.17.0
UAM_PX4_MSGS_COMMIT=86d8239e962f6939e05c3737784f60c02fa884db
UAM_XRCE_AGENT_LABEL=v2.4.3
UAM_XRCE_AGENT_COMMIT=73622810d984349b80bbac0ef55fc0b694d62222

# Source URLs
UAM_PX4_URL=https://github.com/PX4/PX4-Autopilot.git
UAM_PX4_MSGS_URL=https://github.com/PX4/px4_msgs.git
UAM_XRCE_AGENT_URL=https://github.com/eProsima/Micro-XRCE-DDS-Agent.git

# Default locations; callers may export alternatives before running a script.
UAM_PX4_DIR=${UAM_PX4_DIR:-$HOME/dev/PX4-Autopilot}
UAM_ROS_WS=${UAM_ROS_WS:-$HOME/ros2_px4_ws}
UAM_PX4_VENV=${UAM_PX4_VENV:-$HOME/venvs/px4}
UAM_BAG_DIR=${UAM_BAG_DIR:-$HOME/bags}

# Runtime defaults
UAM_DDS_PORT=${UAM_DDS_PORT:-8888}
UAM_RENDER_ENGINE=${UAM_RENDER_ENGINE:-ogre}
UAM_GZ_MODEL=${UAM_GZ_MODEL:-gz_x500}
